@prefix : <urn:absolute:26/6/untitled-ontology-82/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@base <urn:absolute:26/6/untitled-ontology-82/> .

<https://gsya.esi.uclm.es/aurora> rdf:type owl:Ontology ;
                                   owl:imports <https://gsya.esi.uclm.es/roma> .

#################################################################
#    Object Properties
#################################################################

###  https://gsya.esi.uclm.es/aurora#hasAlert
:hasAlert rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :CentralAurora
                                      :LocalAurora
                                    )
                      ] ;
          rdfs:range :Alert .


###  https://gsya.esi.uclm.es/aurora#hasAlertStatus
:hasAlertStatus rdf:type owl:ObjectProperty ;
                rdfs:domain :Alert ;
                rdfs:range :AlertStatus .


###  https://gsya.esi.uclm.es/aurora#hasEvent
:hasEvent rdf:type owl:ObjectProperty ;
          rdfs:domain <https://gsya.esi.uclm.es/roma#Asset> ;
          rdfs:range :Event .


###  https://gsya.esi.uclm.es/aurora#hasLocal
:hasLocal rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :CentralAurora
                                      :LocalAurora
                                    )
                      ] ;
          rdfs:range :LocalAurora .


###  https://gsya.esi.uclm.es/aurora#hasRisk
:hasRisk rdf:type owl:ObjectProperty ;
         rdfs:domain :LocalAurora ;
         rdfs:range <https://gsya.esi.uclm.es/roma#Risk> .


#################################################################
#    Classes
#################################################################

###  https://gsya.esi.uclm.es/aurora#Alert
:Alert rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty <https://gsya.esi.uclm.es/roma#hasControl> ;
                         owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                         owl:onClass <https://gsya.esi.uclm.es/roma#Control>
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasAlertStatus ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :AlertStatus
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty <https://gsya.esi.uclm.es/roma#hasAsset> ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass <https://gsya.esi.uclm.es/roma#Asset>
                       ] .


###  https://gsya.esi.uclm.es/aurora#AlertStatus
:AlertStatus rdf:type owl:Class .


###  https://gsya.esi.uclm.es/aurora#CentralAurora
:CentralAurora rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasAlert ;
                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Alert
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasLocal ;
                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                 owl:onClass :LocalAurora
                               ] .


###  https://gsya.esi.uclm.es/aurora#Event
:Event rdf:type owl:Class .


###  https://gsya.esi.uclm.es/aurora#LocalAurora
:LocalAurora rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasAlert ;
                               owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                               owl:onClass :Alert
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasLocal ;
                               owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                               owl:onClass :LocalAurora
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasRisk ;
                               owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                               owl:onClass <https://gsya.esi.uclm.es/roma#Risk>
                             ] .


###  https://gsya.esi.uclm.es/roma#Asset
<https://gsya.esi.uclm.es/roma#Asset> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                        owl:onProperty :hasEvent ;
                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                        owl:onClass :Event
                                                      ] .


#################################################################
#    Individuals
#################################################################

###  https://gsya.esi.uclm.es/aurora#ActiveAlert
:ActiveAlert rdf:type owl:NamedIndividual ,
                      :AlertStatus .


###  https://gsya.esi.uclm.es/aurora#ResolvedAlert
:ResolvedAlert rdf:type owl:NamedIndividual ,
                        :AlertStatus .


